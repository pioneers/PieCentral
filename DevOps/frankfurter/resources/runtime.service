[Unit]
Description=Robot runtime daemon
Requires=update.service
After=sysinit.target
AssertPathExists=/home/debian/PieCentral/runtime
AssertPathExists=/home/debian/PieCentral/hibike
PartOf=update.service

[Service]
Type=simple
WorkingDirectory=/home/debian/PieCentral/runtime
Environment="PYTHONPATH=/home/debian/PieCentral/hibike:/home/debian/PieCentral/runtime"
ExecStart=/usr/bin/env python3 runtime.py

[Install]
WantedBy=sysinit.target
