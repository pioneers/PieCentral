[Unit]
Description=runtime daemon
After=multi-user.target
Wants=update.service
AssertPathExists=/home/pi/venv/bin/activate
AssertPathExists=/home/pi/storage

[Service]
Type=simple
User=pi
Group=dialout
Environment=PYTHONPATH=/home/pi/storage
ExecStart=/bin/bash -c "sudo rm -f /run/nologin; source /home/pi/venv/bin/activate && python3 -m runtime"
Restart=on-failure
RestartPreventExitStatus=255
RestartSec=3s
OOMScoreAdjust=-950

[Install]
WantedBy=multi-user.target
