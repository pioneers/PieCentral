#!/bin/bash

# docker-frank.sh -- Frankfurter as a docker image

source $(git rev-parse --show-toplevel)/DevOps/frankfurter/scripts/tools/env
set -e

subcmd="$1"
if [ -z "$subcmd" ]; then
  echo -e $error"Error: no subcommand given. Terminating."$clear
  exit 1
fi

usage="Usage: docker [build|run|help]"

case "$subcmd" in
  "build")
    docker build -t frankfurter "$piecentral"
    ;;
  "run")
    # Approximate the resources of a BBB
    docker run -d --cpus=1 --memory="512m" -p 1234:1234 -p 1235:1235 -p 1236:1236 frankfurter
    ;;
  "help")
    echo "$usage"
    ;;
  *)
    echo -e $error"Error: no such subcommand."$clear
    echo -e "$usage"
    exit 1
    ;;
esac
