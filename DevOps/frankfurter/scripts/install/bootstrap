#!/bin/bash

# bootstrap -- Beaglebone-side script that bootstraps the installation process.
#
# Runs interactively within an SSH client.
# Designed to exit quickly so that setup is largely autonomous.

# Enable passwordless sudo for debian
echo "debian ALL=(ALL) NOPASSWD:ALL" | sudo tee --append /etc/sudoers.d/debian
sudo chmod 0440 /etc/sudoers.d/debian

# Install installation service
mkdir -p "$HOME/.config/systemd/user"
mv "$HOME/install.service" "$HOME/.config/systemd/user"
systemctl --user daemon-reload
systemctl --user enable install.service

# Add Google's DNS server
echo "server=8.8.8.8" | sudo tee --append /etc/dnsmasq.conf
sudo systemctl restart dnsmasq.service

sudo mv -f "/etc/machine-id" "$HOME/machine-id"

sudo reboot
