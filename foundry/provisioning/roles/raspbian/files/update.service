# update.service

[Unit]
Description=Robot software updater
After=sysinit.target
AssertPathExists=/home/pi/bin/update.sh

[Service]
Type=simple
ExecStart=-/home/pi/bin/update.sh
RemainAfterExit=yes

[Path]
PathChanged=/home/pi/updates
ExecStart=/home/pi/bin/update.sh

[Install]
WantedBy=sysinit.target
WantedBy=runtime.service
